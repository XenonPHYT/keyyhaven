{
  "name": "keyys-haven",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",

  // Static assets (HTML/CSS/WebP) served by the same Worker
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/share/*", "/media/*", "/user=*"]
  },

  // D1 database — paste your real database id below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keyys-haven-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // R2 bucket for media
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "keyys-haven-media" }
  ],

  // Daily cleanup job (03:00 UTC)
  "triggers": { "crons": ["0 3 * * *"] }

  // Secret (do not put here): set ADMIN_KEY in Dashboard → Worker → Settings → Variables and Secrets
}
