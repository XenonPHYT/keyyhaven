{
  "name": "keyyhaven",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "keep_vars": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/share/*", "/media/*", "/user=*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keyys-haven-db",
      "database_id": "6a804cdf-92ce-46bd-9bc4-17e2d7c6d0fb"
    }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "keyys-haven-media" }
  ],

  "triggers": { "crons": ["0 3 * * *"] }
}
